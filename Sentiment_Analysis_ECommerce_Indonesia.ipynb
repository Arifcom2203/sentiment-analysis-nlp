   "source": [
    "# ── 3.2 Cek Missing Values ───────────────────────────────────────────────\n",
    "print('📋 Missing Values per Kolom:')\n",
    "missing = df.isnull().sum()\n",
    "missing_pct = (missing / len(df) * 100).round(2)\n",
    "missing_df = pd.DataFrame({'Missing Count': missing, 'Missing %': missing_pct})\n",
    "display(missing_df)\n",
    "\n",
    "# Hapus baris dengan missing values jika ada\n",
    "df.dropna(inplace=True)\n",
    "df.reset_index(drop=True, inplace=True)\n",
    "print(f'\\n✅ Data setelah pembersihan: {len(df):,} baris')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ Kolom Teks  : \"review\"\n",
      "✅ Kolom Label : \"sentimen\"\n",
      "\n",
      "Nilai unik label: [0 1]\n"
     ]
    }
   ],
   "source": [
    "# ── 3.3 Deteksi kolom teks & label ──────────────────────────────────────\n",
    "# Cari kolom teks (string) dan kolom label/sentimen\n",
    "text_col = None\n",
    "label_col = None\n",
    "\n",
    "for col in df.columns:\n",
    "    if df[col].dtype == object:\n",
    "        sample_vals = df[col].dropna().head(5).tolist()\n",
    "        avg_len = df[col].dropna().apply(len).mean()\n",
    "        if avg_len > 20 and text_col is None:\n",
    "            text_col = col\n",
    "        elif df[col].nunique() <= 10 and label_col is None and col != 'split':\n",
    "            label_col = col\n",
    "    if df[col].dtype in ['int64', 'float64'] and df[col].nunique() <= 10 and label_col is None:\n",
    "        label_col = col\n",
    "\n",
    "# Fallback: gunakan kolom berdasarkan nama umum\n",
    "common_text_cols  = ['review', 'text', 'ulasan', 'komentar', 'comment', 'Review', 'Text']\n",
    "common_label_cols = ['label', 'sentiment', 'sentimen', 'rating', 'Label', 'Sentiment']\n",
    "\n",
    "for col in common_text_cols:\n",
    "    if col in df.columns and text_col is None:\n",
    "        text_col = col\n",
    "        break\n",
    "for col in common_label_cols:\n",
    "    if col in df.columns and label_col is None:\n",
    "        label_col = col\n",
    "        break\n",
    "\n",
    "if text_col is None:\n",
    "    # Pilih kolom string terpanjang\n",
    "    str_cols = [c for c in df.columns if df[c].dtype == object and c != 'split']\n",
    "    text_col = max(str_cols, key=lambda c: df[c].dropna().apply(len).mean())\n",
    "\n",
    "if label_col is None:\n",
    "    # Pilih kolom dengan kardinalitas rendah\n",
    "    for col in df.columns:\n",
    "        if col != text_col and col != 'split' and df[col].nunique() <= 10:\n",
    "            label_col = col\n",
    "            break\n",
    "\n",
    "print(f'✅ Kolom Teks  : \"{text_col}\"')\n",
    "print(f'✅ Kolom Label : \"{label_col}\"')\n",
    "print(f'\\nNilai unik label: {df[label_col].unique()}')"
   ]
  },
