    "# Memuat dataset dari Hugging Face\n",
    "print('🔄 Memuat dataset dari Hugging Face...')\n",
    "dataset = load_dataset('dipawidia/ecommerce-product-reviews-sentiment')\n",
    "print('✅ Dataset berhasil dimuat!')\n",
    "print()\n",
    "print('Struktur dataset:')\n",
    "print(dataset)"
