   ],
   "source": [
    "# ── 4.2 Fungsi-fungsi Preprocessing ─────────────────────────────────────\n",
    "\n",
    "def case_folding(text):\n",
    "    \"\"\"Mengubah teks menjadi huruf kecil.\"\"\"\n",
    "    return str(text).lower()\n",
    "\n",
    "def cleaning(text):\n",
    "    \"\"\"Membersihkan teks: hapus URL, mention, hashtag, angka, tanda baca.\"\"\"\n",
    "    # Hapus URL\n",
    "    text = re.sub(r'http\\S+|www\\.\\S+', '', text)\n",
    "    # Hapus mention (@username) dan hashtag (#tag)\n",
    "    text = re.sub(r'@\\w+|#\\w+', '', text)\n",
    "    # Hapus angka\n",
    "    text = re.sub(r'\\d+', '', text)\n",
    "    # Hapus tanda baca\n",
    "    text = text.translate(str.maketrans('', '', string.punctuation))\n",
    "    # Hapus karakter non-ASCII (emoji, simbol)\n",
    "    text = re.sub(r'[^\\x00-\\x7F\\u00C0-\\u024F\\u0100-\\u017F]+', '', text)\n",
    "    # Hapus spasi berlebih\n",
    "    text = re.sub(r'\\s+', ' ', text).strip()\n",
    "    return text\n",
    "\n",
    "def tokenisasi(text):\n",
    "    \"\"\"Memisahkan teks menjadi daftar token/kata.\"\"\"\n",
    "    return word_tokenize(text)\n",
    "\n",
    "def stopword_removal(tokens):\n",
    "    \"\"\"Menghapus stopwords dari daftar token.\"\"\"\n",
    "    return [token for token in tokens if token not in stop_words_id and len(token) > 1]\n",
    "\n",
    "def stemming(tokens):\n",
    "    \"\"\"Mengubah setiap token ke bentuk dasarnya (Bahasa Indonesia).\"\"\"\n",
    "    return [stemmer.stem(token) for token in tokens]\n",
    "\n",
    "def full_preprocessing(text):\n",
    "    \"\"\"Pipeline lengkap preprocessing teks.\"\"\"\n",
    "    text = case_folding(text)        # Step 1: Case Folding\n",
    "    text = cleaning(text)            # Step 2: Cleaning\n",
    "    tokens = tokenisasi(text)        # Step 3: Tokenisasi\n",
    "    tokens = stopword_removal(tokens)# Step 4: Stopword Removal\n",
    "    tokens = stemming(tokens)        # Step 5: Stemming\n",
    "    return ' '.join(tokens)\n",
    "\n",
    "print('✅ Fungsi preprocessing berhasil didefinisikan!')\n",
    "\n",
    "# Contoh cepat\n",
    "contoh = 'Produk SANGAT bagus!!! Pengiriman CEPAT bgt, recommended 100% deh :)'\n",
    "print(f'\\nContoh teks     : {contoh}')\n",
    "print(f'Setelah proses  : {full_preprocessing(contoh)}')"
   ]
  },
