    "# ── 4.1 Inisialisasi Tools ───────────────────────────────────────────────\n",
    "\n",
    "# Stemmer Bahasa Indonesia (PySastrawi)\n",
    "factory = StemmerFactory()\n",
    "stemmer = factory.create_stemmer()\n",
    "\n",
    "# Stopwords Bahasa Indonesia\n",
    "stop_words_id = set(stopwords.words('indonesian'))\n",
    "\n",
    "# Tambahkan stopwords kustom (kata informal umum di ulasan e-commerce)\n",
    "custom_stopwords = {\n",
    "    'yg', 'yang', 'dgn', 'dengan', 'utk', 'untuk', 'dan', 'di', 'ke', 'dari',\n",
    "    'ini', 'itu', 'ada', 'aja', 'juga', 'saya', 'aku', 'sy', 'kita', 'kali',\n",
    "    'udah', 'sudah', 'sdh', 'bisa', 'bgt', 'banget', 'sangat', 'sekali',\n",
    "    'tapi', 'tapi', 'tp', 'atau', 'atau', 'ga', 'gak', 'tidak', 'tdk',\n",
    "    'nya', 'lah', 'nih', 'sih', 'deh', 'dong', 'mas', 'mba', 'kak',\n",
    "    'pcs', 'item', 'produk'\n",
    "}\n",
    "stop_words_id.update(custom_stopwords)\n",
    "\n",
    "print(f'✅ Stemmer PySastrawi siap digunakan')\n",
    "print(f'✅ Total stopwords: {len(stop_words_id)} kata')"
   ]
