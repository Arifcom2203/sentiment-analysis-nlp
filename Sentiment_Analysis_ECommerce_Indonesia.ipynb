   "source": [
    "# ── 3.4 Distribusi Label Sentimen ────────────────────────────────────────\n",
    "label_counts = df[label_col].value_counts()\n",
    "label_pct    = df[label_col].value_counts(normalize=True) * 100\n",
    "\n",
    "print('=' * 50)\n",
    "print('     DISTRIBUSI LABEL SENTIMEN')\n",
    "print('=' * 50)\n",
    "for label, count in label_counts.items():\n",
    "    pct = label_pct[label]\n",
    "    bar = '█' * int(pct / 2)\n",
    "    print(f'  {str(label):15s} : {count:5,} ({pct:.1f}%)  {bar}')\n",
    "print('=' * 50)\n",
    "\n",
    "# Visualisasi distribusi\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "\n",
    "# Bar Chart\n",
    "colors = sns.color_palette('husl', n_colors=len(label_counts))\n",
    "bars = axes[0].bar(label_counts.index.astype(str), label_counts.values, color=colors, edgecolor='black', linewidth=0.8)\n",
    "axes[0].set_title('Distribusi Label Sentimen', fontsize=15, fontweight='bold', pad=15)\n",
    "axes[0].set_xlabel('Label Sentimen', fontsize=12)\n",
    "axes[0].set_ylabel('Jumlah Data', fontsize=12)\n",
    "for bar, count in zip(bars, label_counts.values):\n",
    "    axes[0].text(bar.get_x() + bar.get_width()/2, bar.get_height() + 10,\n",
    "                 f'{count:,}', ha='center', va='bottom', fontweight='bold', fontsize=11)\n",
    "axes[0].tick_params(axis='x', rotation=15)\n",
    "\n",
    "# Pie Chart\n",
    "wedges, texts, autotexts = axes[1].pie(\n",
